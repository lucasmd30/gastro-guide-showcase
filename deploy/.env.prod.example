# Template for the production environment file.
# Copy it to .env.prod at the project root, on the VM, and fill it in.
#
#   cp deploy/.env.prod.example .env.prod && chmod 600 .env.prod
#
# NEVER commit .env.prod; it is in .gitignore. This file is only the template
# and contains no secrets.

# ---------- Domain and TLS ----------
# Domain already pointing (A records for the root and www) to the VM IP. Caddy
# issues the certificates by itself on first start. No "https://" or "www"
# here; the Caddyfile derives www from this value.
DOMINIO=exemplo.com.br
# Email for Let's Encrypt expiry notices.
EMAIL_TLS=voce@exemplo.com.br

# ---------- Database (Magalu DBaaS) ----------
# Host and port come from the DBaaS panel, after creating the instance.
DB_HOST=xxxxx.dbaas.mgc.cloud.br
DB_PORT=5432
DB_NAME=gastroguide
DB_USER=gastroguide
# Password generated in the DBaaS panel. Never reuse the development one.
DB_PASSWORD=

# Connection pool size. 10 is right for the small database instance (BV1-4,
# 1 vCPU); use 20 when moving to BV4-8. Raising it without growing the
# database makes things worse, not better.
DB_POOL_MAX=10

# ---------- Images ----------
# Which CI image version to run. Empty = `latest` (the last push to master that
# passed the tests). To go back to an earlier version, pin the tag
# `sha-<first 7 characters of the commit>`, which CI also publishes.
# IMAGE_TAG=sha-abc1234

# ---------- JWT secret ----------
# Generate with:  openssl rand -base64 48
# Changing this value invalidates everyone's session, which is exactly what
# you want if you suspect a leak.
JWT_SECRET=

# ---------- Object Storage (external backup) ----------
# Bucket in a SEPARATE account/project from the database: a backup in the same
# place as the data does not protect against a compromised or closed account.
S3_ENDPOINT=https://br-se1.magaluobjects.com
S3_BUCKET=meu-bucket-de-backup
S3_ACCESS_KEY=
S3_SECRET_KEY=
# How many days of daily backups to keep in the bucket.
RETENCAO_DIAS=90

# ---------- Log ----------
# INFO in production. DEBUG prints patient data to the log: use it only to
# investigate a specific problem, then go back to INFO.
LOG_LEVEL=INFO

# ---------- Monitoring (docker-compose.monitoring.yml) ----------
# Only needed if you start the monitoring stack too. Magalu has no
# observability product; the Grafana Cloud free tier comfortably covers this
# installation.
# These three come from "Connections > Prometheus" in Grafana Cloud.
GRAFANA_PROM_URL=https://prometheus-prod-XX-prod-sa-east-0.grafana.net/api/prom/push
GRAFANA_PROM_USER=
GRAFANA_PROM_PASSWORD=

# Read-only database user, just for metrics. It deliberately does not share
# the application user.
METRICS_DB_USER=metrics
METRICS_DB_PASSWORD=
